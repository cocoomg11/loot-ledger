{
  "id": "loot-ledger",
  "title": "Loot Ledger",
  "description": "Priced, rollable loot pools for dnd5e, built from a classic-MMO item compendium module: sell prices that match the source's vendor prices, rarity from item quality, and roll tables by level band, quality, item type, mixed drop and creature type. An optional 5e conversion of every item, with a GM review board, is off by default.",
  "version": "0.4.0",
  "authors": [
    {
      "name": "cocoomg11"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.0.0",
          "verified": "6.0.6"
        }
      }
    ],
    "requires": [
      {
        "id": "wow-classic-items",
        "type": "module"
      }
    ],
    "recommends": [
      {
        "id": "item-piles",
        "type": "module",
        "reason": "Merchant tables: Item Piles merchants are pointed at shop roll tables and restocked from them."
      },
      {
        "id": "wayfarers-toolkit",
        "type": "module"
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "vendor/wanderers-core/styles/wanderers-ui.css",
    "styles/loot-ledger.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "url": "https://github.com/cocoomg11/loot-ledger",
  "manifest": "https://github.com/cocoomg11/loot-ledger/releases/latest/download/module.json",
  "download": "https://github.com/cocoomg11/loot-ledger/releases/download/v0.4.0/module.zip",
  "bugs": "https://github.com/cocoomg11/loot-ledger/issues",
  "license": "LICENSE",
  "readme": "README.md"
}
